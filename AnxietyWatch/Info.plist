<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.groundeffectsoftware.AnxietyWatch.refresh</string>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>CSV File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.comma-separated-values-text</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The sync server is self-hosted and its address is entered at runtime,
		     so a domain-scoped exception cannot be known at build time.

		     NSAllowsLocalNetworking alone did not exempt plain HTTP to a private
		     IP and blocked fresh-install restore. NSAllowsArbitraryLoads is therefore
		     required for the user-configured server; the local-network key documents
		     the intended scope but is not a functional fallback. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>OuraClientID</key>
	<string>$(OURA_CLIENT_ID)</string>
	<key>OuraClientSecret</key>
	<string>$(OURA_CLIENT_SECRET)</string>
	<key>OuraRedirectURI</key>
	<string>$(OURA_REDIRECT_URI)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>health-update</string>
		<string>bluetooth-central</string>
	</array>
</dict>
</plist>
