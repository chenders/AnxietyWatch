# macOS
.DS_Store
*.swp

# Superpowers brainstorm sessions
.superpowers/

# Xcode
build/
DerivedData/
*.xcuserdata
xcuserdata/
*.xcworkspace/xcuserdata/
*.moved-aside
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
!default.pbxuser
!default.mode1v3
!default.mode2v3
!default.perspectivev3

# AI / local tooling
.claude/settings.local.json
.claude/pii-denylist.local.txt
.claude/worktrees/
.serena/
.superpowers/
.playwright-mcp/
.xcodebuildmcp/
.idea/

# Python
.venv/
__pycache__/
*.pyc

# Server (supplements server/.gitignore)
server/.env
server/__pycache__/
AnxietyWatch/Utilities/BuildVersion.swift

# Oura OAuth secrets — real values only, template is Config/Oura.xcconfig.example
Config/Oura.xcconfig

# Scratch screenshots / images not intended for the repo (root level only)
/*.png

# Scratch / artifact directories (local-only data, not for the repo)
/.remember/
/cpap/
/oscar/
/psych_research
/docs/plans/expert-review-agent-specific/
/docs/superpowers/plans/

# Local agent state
.claude/scheduled_tasks.lock

# .claude/hooks: ignore by default (most hooks are personal/local-only,
# e.g. post-tool-call.py keyed to the maintainer's provenance server).
# Add an explicit `!` exception below for each hook that should ship
# with the repo and run for every contributor.
.claude/hooks/*
!.claude/hooks/swiftlint-edited.py
!.claude/hooks/pre-pr-reviewer-reminder.py
!.claude/hooks/flake8-edited.py
!.claude/hooks/voiceover-consistency-edited.py
!.claude/hooks/block-pii-in-fixtures.py
!.claude/hooks/medication-name-drift-warn.py
!.claude/hooks/pii-push-gate.py

# Clinical chart pipeline — local-only. Inputs are HIPAA-sensitive
# prod pulls, outputs are large rendered artifacts; neither belongs in
# the repo.
/clinical-charts/
/clinical-charts copy/

# Local screenshot directories (root level only).
/screenshots/
/report-screenshots/

# CSV / PDF / image / Python at the repo root — historical dumping
# ground for prod-pull CSVs (OSCAR, EMAY oximeter), clinical-context
# PDFs, scratch images, and ad-hoc Python scripts. Anchored with the
# leading slash so server/ and AnxietyWatch/ source isn't ignored.
/*.csv
/*.spo2
/*.pdf
# iOS hang / crash reports re-exported from Settings → Analytics &
# Improvements → Analytics Data during local debugging.
/*.ips
/*.jpg
/*.txt
/*.yml
/*.py

# Scratch markdown at the repo root only — keep the actual project
# docs by whitelisting them.
/*.md
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/REQUIREMENTS.md
!/DATA_AND_REPORTS.md
!/SETUP_GUIDE.md
!/SECURITY.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/PROJECT_FUTURE_PLAN.md
!/CHANGELOG.md
!/LICENSE.md

# Instruments / network capture artifacts (may contain live session data)
*.trace/
*.trace
# SPM build artifacts
AnxietyWatchKit/.build/
AnxietyWatchKit/.swiftpm/


# Scratch
debug_*
Scratch/
